{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palette.local/research/v4/capability-graph/schema/fragment.schema.json",
  "title": "Capability Graph Mapping Fragment",
  "description": "An independently authored set of artifact type definitions and census mechanism typing records. Fragments are inputs to a later generator, not partial architecture documents.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "documentKind",
    "schemaVersion",
    "fragmentId",
    "title",
    "description",
    "sourceSnapshot",
    "artifactTypes",
    "mechanismTypings",
    "notes"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "documentKind": {
      "const": "capability-graph-mapping-fragment"
    },
    "schemaVersion": {
      "const": "1.3.0"
    },
    "fragmentId": {
      "type": "string",
      "pattern": "^fragment\\.[a-z0-9]+(?:[.-][a-z0-9]+)*\\.v[1-9][0-9]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "sourceSnapshot": {
      "$ref": "capability-graph.schema.json#/$defs/sourceSnapshot"
    },
    "artifactTypes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "capability-graph.schema.json#/$defs/artifactType"
      }
    },
    "mechanismTypings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "capability-graph.schema.json#/$defs/mechanismRecord"
      }
    },
    "notes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
